{
  "name": "@voiceminusone/test-pipeline",
  "version": "0.0.1",
  "private": true,
  "description": "Automated test pipeline that tests the VoiceMinusOne SDK from an audio file",
  "type": "module",
  "scripts": {
    "test:audio": "node --experimental-strip-types src/run.ts",
    "test:audio:dev": "tsx src/run.ts",
    "test:real": "node --experimental-strip-types src/run-real.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@voiceminusone/adapter-ai-sdk": "workspace:*",
    "@voiceminusone/core": "workspace:*",
    "@voiceminusone/provider-sarvam": "workspace:*",
    "ai": "^7.0.58",
    "ai-sdk-ollama": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
