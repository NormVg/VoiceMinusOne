{
  "name": "@voiceminusone/client",
  "version": "0.0.1",
  "description": "Browser client for VoiceMinusOne — mic, speaker, VAD, VoiceMinusOneClient",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@voiceminusone/core": "workspace:*",
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
