{
  "name": "voiceminusone",
  "version": "0.0.0",
  "private": true,
  "description": "Plugin-based voice SDK for application-based AI voice agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --filter=./packages/* --parallel run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:audio": "pnpm --filter @voiceminusone/test-pipeline run test:audio",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "clean": "pnpm -r --filter=./packages/* exec rm -rf dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
